# Generate with: openssl rand -hex 32
SECRET_KEY_BASE=
# Dedicated GitHub PAT encryption keyring; values are base64-encoded 32-byte keys.
# Example shape only: {"2026-08":"<base64-32-byte-key>"}
FORNACAST_GITHUB_CREDENTIAL_KEYS=
FORNACAST_GITHUB_CREDENTIAL_ACTIVE_KEY_ID=

# PostgreSQL domain database used by the default Compose deployment.
POSTGRES_DB=fornacast_prod
POSTGRES_USER=fornacast
POSTGRES_PASSWORD=
# The legacy Ecto path defaults to /data/fornacast.db in the release image.
# Leave acknowledgement blank. Set it to true only after intentionally backing up and completing the legacy Turso transition.
FORNACAST_ACKNOWLEDGE_LEGACY_TURSO_DATA=

FORNACAST_BASE_URL=http://localhost:4000
FORNACAST_SSH_HOST=localhost
FORNACAST_SSH_PORT=2222
FORNACAST_RELEASE_ASSET_STORAGE_ROOT=/data/release-assets
FORNACAST_RELEASE_ASSET_MAX_BYTES=2147483648
FORNACAST_RELEASE_ASSET_GC_GRACE_SECONDS=86400

# Concord config store (separate from the PostgreSQL domain database).
# These variables configure Concord's embedded Turso/VSR configuration store, not Fornacast.Repo.
FORNACAST_CONFIG_DATABASE_PATH=/data/fornacast_config.db
FORNACAST_CONFIG_TURSO_DATABASE_URL=
FORNACAST_CONFIG_TURSO_AUTH_TOKEN=
