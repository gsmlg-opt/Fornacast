<RepositoryHTML.repository_frame result={@result} active={:issues}>
  <section class="grid min-w-0 gap-3 p-4" data-issue-conversation>
    <header class="bg-surface-container text-on-surface rounded-lg p-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-xs text-on-surface-variant">Issue #{@result.content.issue.number}</p>
          <h2 class="text-lg font-semibold">{@result.content.issue.title}</h2>
          <p class="mt-1 text-xs text-on-surface-variant">
            Opened by {author_name(@result.content.issue.author)} · {comment_label(
              @result.content.comments.total
            )}
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <.dm_badge variant={state_variant(@result.content.issue.state)} soft size="sm">
            {@result.content.issue.state}
          </.dm_badge>
          <.dm_link
            :if={@result.content.issue.capabilities.can_edit}
            href={RepositoryHTML.edit_issue_path(@result.chrome, @result.content.issue.number)}
          >
            Edit
          </.dm_link>
          <form
            :if={@result.content.issue.capabilities.can_close}
            action={RepositoryHTML.issue_state_path(@result.chrome, @result.content.issue.number)}
            method="post"
          >
            <input type="hidden" name="_csrf_token" value={csrf_token()} />
            <input type="hidden" name="_method" value="patch" />
            <input
              type="hidden"
              name="state"
              value={if @result.content.issue.state == :open, do: "closed", else: "open"}
            />
            <.dm_btn type="submit" variant="outline" size="sm">
              {if @result.content.issue.state == :open, do: "Close", else: "Reopen"}
            </.dm_btn>
          </form>
        </div>
      </div>
      <div
        :if={@result.content.issue.labels != []}
        class="mt-3 flex flex-wrap gap-2"
        aria-label="Labels"
      >
        <.dm_badge
          :for={label <- @result.content.issue.labels}
          variant="secondary"
          soft
          size="xs"
        >
          {label_name(label)}
        </.dm_badge>
      </div>
    </header>

    <article class="bg-surface-container text-on-surface rounded-lg border border-outline-variant">
      <header class="border-b border-outline-variant px-4 py-3 text-sm">
        <span class="font-semibold">{author_name(@result.content.issue.author)}</span>
        <span class="text-on-surface-variant">
          opened this issue {format_time(@result.content.issue.inserted_at)}
        </span>
      </header>
      <div class="prose max-w-none p-4 text-on-surface">
        {markdown(@result.content.issue.body)}
      </div>
    </article>

    <ol :if={@result.content.comments.entries != []} class="grid gap-3" aria-label="Comments">
      <li
        :for={comment <- @result.content.comments.entries}
        class="bg-surface-container text-on-surface rounded-lg border border-outline-variant"
      >
        <header class="border-b border-outline-variant px-4 py-3 text-sm">
          <span class="font-semibold">{author_name(comment.author)}</span>
          <span class="text-on-surface-variant">
            commented {format_time(comment.inserted_at)}
          </span>
        </header>
        <div class="prose max-w-none p-4 text-on-surface">{markdown(comment.body)}</div>
        <div
          :if={comment.capabilities.can_edit or comment.capabilities.can_delete}
          class="grid gap-3 border-t border-outline-variant p-4"
        >
          <form
            :if={comment.capabilities.can_edit}
            action={
              RepositoryHTML.issue_comment_path(
                @result.chrome,
                @result.content.issue.number,
                comment.id
              )
            }
            method="post"
            class="grid gap-3"
          >
            <input type="hidden" name="_csrf_token" value={csrf_token()} />
            <input type="hidden" name="_method" value="patch" />
            <.dm_alert
              :for={
                error <-
                  resource_errors(
                    comment_errors(@result.content, {:edit, to_string(comment.id)}),
                    "IssueComment"
                  )
              }
              variant="error"
            >
              {error}
            </.dm_alert>
            <.dm_textarea
              id={"issue-comment-#{comment.id}"}
              name="comment[body]"
              label="Edit comment"
              value={
                form_value(
                  comment_values(@result.content, {:edit, to_string(comment.id)}),
                  "body",
                  comment.body
                )
              }
              errors={
                field_errors(
                  comment_errors(@result.content, {:edit, to_string(comment.id)}),
                  "IssueComment",
                  "body"
                )
              }
              rows={4}
            />
            <.dm_btn type="submit" variant="outline" size="sm">Save comment</.dm_btn>
          </form>
          <form
            :if={comment.capabilities.can_delete}
            action={
              RepositoryHTML.issue_comment_path(
                @result.chrome,
                @result.content.issue.number,
                comment.id
              )
            }
            method="post"
          >
            <input type="hidden" name="_csrf_token" value={csrf_token()} />
            <input type="hidden" name="_method" value="delete" />
            <.dm_btn type="submit" variant="error" size="sm">Delete comment</.dm_btn>
          </form>
        </div>
      </li>
    </ol>

    <RepositoryHTML.optional_panel
      :if={@result.content.comments.entries == []}
      title="No comments"
      message="No comments yet."
      kind="empty"
    />

    <form
      :if={@result.content.issue.capabilities.can_comment}
      action={RepositoryHTML.issue_comments_path(@result.chrome, @result.content.issue.number)}
      method="post"
      class="grid gap-3 bg-surface-container text-on-surface rounded-lg p-4"
      data-issue-comment-form
    >
      <input type="hidden" name="_csrf_token" value={csrf_token()} />
      <.dm_alert
        :for={error <- resource_errors(comment_errors(@result.content, :create), "IssueComment")}
        variant="error"
      >
        {error}
      </.dm_alert>
      <.dm_textarea
        id="issue-comment-body"
        name="comment[body]"
        label="Comment"
        value={form_value(comment_values(@result.content, :create), "body")}
        errors={field_errors(comment_errors(@result.content, :create), "IssueComment", "body")}
        rows={6}
        required
      />
      <.dm_btn type="submit" variant="primary">Add comment</.dm_btn>
    </form>
  </section>
</RepositoryHTML.repository_frame>
