<div class="flex flex-wrap items-center justify-between gap-4">
  <p class="muted">{@description}</p>
  <.dm_link
    :if={@can_manage_organization}
    href={"/organizations/#{@owner.username}/settings"}
    class="btn btn-outline"
  >
    Settings
  </.dm_link>
</div>
<table class="data-table">
  <thead>
    <tr>
      <th>Repository</th>
      <th>Visibility</th>
      <th>Default branch</th>
    </tr>
  </thead>
  <tbody>
    <tr :for={view <- @repository_views}>
      <td>
        <a href={"/#{@owner.username}/#{view.repository.slug}"}>{view.repository.name}</a>
      </td>
      <td>{view.repository.visibility}</td>
      <td>{view.repository.default_branch}</td>
    </tr>
  </tbody>
</table>
