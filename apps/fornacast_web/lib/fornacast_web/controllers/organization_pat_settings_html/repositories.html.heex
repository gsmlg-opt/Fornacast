<OrganizationSettingsComponents.organization_settings_layout
  organization={@organization}
  active={:github}
>
  <section class="grid gap-4" data-pat-repositories>
    <header class="grid gap-2">
      <.dm_link href={base(@organization)} class="text-primary">Back to GitHub configuration</.dm_link>
      <h2 class="text-2xl font-semibold">Synchronized repositories</h2>
      <p class="text-on-surface-variant">
        Manage repository selection and Git/LFS synchronization for {@view.config.github_organization}.
      </p>
    </header>
    <.dm_alert :if={@error} id="pat-repositories-error" variant="error" role="alert">
      {@error}
    </.dm_alert>
    <.dm_alert :if={@flash} id="pat-repositories-saved" variant="success" role="status">
      {@flash}
    </.dm_alert>
    <.dm_card id="pat-repositories-sync" variant="bordered" padding="lg">
      <:title>Synchronize organization</:title>
      <p class="text-sm text-on-surface-variant">
        Sync now immediately starts background synchronization of all PAT-visible repositories in the GitHub organization, regardless of the saved repository selection.
      </p>
      <form action={base(@organization) <> "/sync"} method="post" class="mt-4">
        <input type="hidden" name="_csrf_token" value={csrf_token()} />
        <input type="hidden" name="pat_sync[lock_version]" value={@view.config.lock_version} />
        <button
          class="btn btn-primary"
          type="submit"
          disabled={!@view.config.enabled or @view.config.paused}
        >Sync now</button>
      </form>
      <p :if={!@latest_run} class="mt-2 text-sm text-on-surface-variant">Never synchronized</p>
      <.task_report :if={@latest_run} organization={@organization} run={@latest_run} />
      <.dm_link :if={!@latest_run} href={base(@organization) <> "/runs"} class="text-primary">Synchronization history</.dm_link>
    </.dm_card>
    <.dm_card id="pat-git-mirrors" variant="bordered" padding="lg">
      <:title>Bidirectional Git and LFS</:title>
      <p class="text-sm text-on-surface-variant">
        Enroll existing imported repositories to synchronize branches, tags and LFS in both directions.
        Divergent histories remain conflicts. Active synchronization must finish before enrollment.
      </p>
      <p :if={@pat_mirror.organization_mirror} class="mt-2 text-sm">
        Mirror state: {@pat_mirror.organization_mirror.state}.
        <.dm_link href={base(@organization) <> "/conflicts"} class="text-primary">View synchronization conflicts</.dm_link>
      </p>
      <p :if={@pat_mirror.candidates == []} class="mt-2">
        Import repositories into this organization with the configured saved PAT first.
      </p>
      <form
        :if={@pat_mirror.candidates != []}
        action={base(@organization) <> "/repositories/mirror"}
        method="post"
        class="mt-4 grid gap-3"
      >
        <input type="hidden" name="_csrf_token" value={csrf_token()} />
        <input type="hidden" name="pat_sync[lock_version]" value={@view.config.lock_version} />
        <input type="hidden" name="pat_sync[repository_ids][]" value="" />
        <.dm_input
          id="pat-git-repositories"
          type="checkbox_group"
          name="pat_sync[repository_ids]"
          label="Imported repositories"
          options={
            Enum.map(@pat_mirror.candidates, fn candidate ->
              {candidate.source_full_name <> if(candidate.enrolled, do: " (enrolled)", else: ""),
               candidate.repository_id}
            end)
          }
          value={
            for candidate <- @pat_mirror.candidates,
                candidate.enrolled,
                do: candidate.repository_id
          }
        />
        <p class="text-sm text-on-surface-variant">
          Select enrolled repositories again to authorize a changed configuration or renewed PAT.
          Unchecked repositories retain their existing connection.
        </p>
        <div>
          <.dm_btn
            type="submit"
            variant="primary"
            disabled={!@view.config.enabled or @view.config.paused}
          >
            Enable or reauthorize selected repositories
          </.dm_btn>
        </div>
      </form>
    </.dm_card>
    <.dm_card id="pat-repositories-list" variant="bordered" padding="lg">
      <:title>Repository selection</:title>
      <p class="text-sm text-on-surface-variant">
        Only repositories visible to the selected owner’s PAT can be listed. Refreshing reads GitHub; it does not import repositories.
      </p>
      <form
        :if={@view.config.id}
        action={base(@organization) <> "/repositories/refresh"}
        method="post"
        class="my-4"
      >
        <input type="hidden" name="_csrf_token" value={csrf_token()} />
        <input type="hidden" name="pat_sync[lock_version]" value={@view.config.lock_version} />
        <button type="submit" class="btn btn-secondary">Refresh from GitHub</button>
      </form>
      <p :if={!@view.config.id}>
        Save an owner PAT and GitHub organization in configuration first.
      </p>
      <form
        :if={@view.config.id}
        action={base(@organization) <> "/repositories"}
        method="post"
        class="grid gap-4"
      >
        <input type="hidden" name="_csrf_token" value={csrf_token()} />
        <input type="hidden" name="_method" value="patch" />
        <input type="hidden" name="pat_sync[lock_version]" value={@view.config.lock_version} />
        <input type="hidden" name="pat_sync[selected_repository_ids][]" value="" />
        <label class="grid gap-1" for="pat-repository-selection">
          <span>Saved synchronization scope</span>
          <select
            class="select"
            id="pat-repository-selection"
            name="pat_sync[repository_selection]"
          >
            <option value="all" selected={@view.config.repository_selection == "all"}>
              All PAT-visible repositories
            </option>
            <option value="selected" selected={@view.config.repository_selection == "selected"}>
              Selected repositories only
            </option>
          </select>
        </label>
        <p :if={repository_rows(@view) == []}>
          No repositories listed. Refresh from GitHub to choose individual repositories.
        </p>
        <div :if={repository_rows(@view) != []} class="overflow-x-auto">
          <table class="table" aria-label="PAT-visible GitHub repositories">
            <thead>
              <tr>
                <th>Select</th><th>Repository</th><th>Visibility</th>
              </tr>
            </thead>
            <tbody>
              <tr :for={repo <- repository_rows(@view)}>
                <td>
                  <input
                    type="checkbox"
                    class="checkbox"
                    name="pat_sync[selected_repository_ids][]"
                    value={repo["id"]}
                    checked={selected?(@view.config, repo["id"])}
                    aria-label={"Synchronize " <> repo["full_name"]}
                  />
                </td>
                <th scope="row">{repo["full_name"]}</th><td>{repo["visibility"]}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-sm text-on-surface-variant">
          Choose “Selected repositories only” to save the checkboxes. Sync now always includes all PAT-visible organization repositories. Unselected repositories are retained locally.
        </p>
        <div>
          <button type="submit" class="btn btn-primary">Save repository selection</button>
        </div>
      </form>
      <p class="mt-4 text-sm text-on-surface-variant">
        Saving repository selection does not synchronize repository contents.
      </p>
    </.dm_card>
  </section>
</OrganizationSettingsComponents.organization_settings_layout>
