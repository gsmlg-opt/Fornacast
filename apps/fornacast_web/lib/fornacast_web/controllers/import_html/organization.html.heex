<section
  class="grid gap-4 bg-surface-container-low text-on-surface rounded-2xl p-6"
  data-organization-import
>
  <header class="grid gap-2">
    <p class="text-xs text-on-surface-variant">GitHub synchronization</p>
    <h2 class="text-2xl font-semibold">Import organization from GitHub</h2>
    <p class="text-sm text-on-surface-variant max-w-3xl">
      Choose public repository access or connect a GitHub App to your local organization.
    </p>
  </header>
  <.dm_alert :if={@error} id="organization-import-error" variant="error" outlined role="alert">
    {@error}
  </.dm_alert>
  <div class="grid gap-4 md:grid-cols-2">
    <.dm_card id="organization-import-public" variant="bordered" shadow="sm" padding="lg">
      <:title><span class="text-lg font-semibold">Public repositories</span></:title>
      <p class="text-sm text-on-surface-variant">
        Discover and import an organization's public repositories without a GitHub account or token.
      </p>
      <:action>
        <.dm_link href="/organizations/import/public" class="btn btn-primary">Synchronize public repositories</.dm_link>
      </:action>
    </.dm_card>
    <.dm_card id="organization-import-app" variant="bordered" shadow="sm" padding="lg">
      <:title><span class="text-lg font-semibold">GitHub App</span></:title>
      <p class="text-sm text-on-surface-variant">
        Install and authorize the App for your GitHub organization, then choose repositories available to its connection.
      </p>
      <:action>
        <.dm_link href="/organizations/import/app" class="btn btn-secondary">Install and connect GitHub App</.dm_link>
      </:action>
    </.dm_card>
  </div>
</section>
